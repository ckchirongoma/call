# Call — every environment variable, in one place. Copy to .env.local, or set
# in Vercel → Settings → Environment Variables. Redeploy after changing one.

# ── Required ──────────────────────────────────────────────────────
SUPABASE_URL=
# Bypasses RLS. Vercel only; never a browser, never the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Post-call model work. Which model does which job is the model_config table.
OPENROUTER_API_KEY=
# Any long random string: authenticates /api/worker, /api/render-pdf, /admin detail.
WORKER_SECRET=
# e.g. https://call.vercel.app — used in links and for this deployment calling itself.
PUBLIC_BASE_URL=
# Pepper for login codes, session cookies and signed PDF links.
SESSION_SECRET=

# ── ElevenLabs (the voice agent) ──────────────────────────────────
# Without these the backend still ingests scripted webhooks (tests) and the
# push-agent script refuses to run.
ELEVENLABS_API_KEY=
# From the post-call webhook settings. Verifies elevenlabs-signature over raw bytes.
ELEVENLABS_WEBHOOK_SECRET=
# Sent by the agent's server tools as x-call-secret. Any long random string.
VOICE_TOOL_SECRET=
# Assumption for the cost ledger until measured; shown on /admin.
ELEVENLABS_CENTS_PER_MINUTE=10
# Free plan 15, Starter 75. The ledger warns at 80%.
ELEVENLABS_MINUTES_INCLUDED=15

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# Until a domain is verified, leave unset: onboarding@resend.dev only delivers to the account's own address.
QUOTE_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Where operator alerts go (never in code).
ALERT_EMAIL_TO=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=call-verify
WHATSAPP_API_VERSION=v21.0
# Name of the approved utility template for first-contact quotes.
WHATSAPP_TEMPLATE_QUOTE_READY=quote_ready
WHATSAPP_TEMPLATE_BROKER_NEW_QUOTE=broker_new_quote

# ── Transcription, direct (optional) ──────────────────────────────
# In-person meetings are transcribed by the `voice` row in model_config. Its
# default provider is openrouter (OPENROUTER_API_KEY above); set the row's
# provider to groq or openai and the matching key here to go direct.
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Guardrail engine (optional) ───────────────────────────────────
# Jev. Absent → the `safety` and `checker` rows in model_config run the same checks; /api/health says which.
TYPESAFE_API_KEY=

# ── Operations ────────────────────────────────────────────────────
# Vercel sends this on scheduled runs; cron endpoints fail closed without it.
CRON_SECRET=
# Opens /admin.
ADMIN_SECRET=
# Daily OpenRouter request budget the limits guard counts against (free: ~50 with <$10 credit).
OPENROUTER_DAILY_BUDGET=50
# Days before recordings are deleted when a broker has not set their own.
DEFAULT_RETENTION_DAYS=30

# ── Chase Intelligence (docs/INTEL-CONTRACT.md) ───────────────────
# full (default) | meta (the shape, no words) | off. Nothing else changes with it.
INTEL_CAPTURE=full
